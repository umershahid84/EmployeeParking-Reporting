NODE_ENV=development
PORT=4000

# MariaDB connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=parking_app
DB_PASSWORD=changeme
DB_NAME=employee_parking_reporting

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Password reset
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# SMTP / email (configurable provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Employee Parking Reporting <no-reply@example.com>"

# Frontend origin allowed for CORS
CLIENT_ORIGIN=http://localhost:5173
