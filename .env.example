# Employee Parking Daily Reporting Application
# Copy this file to .env (at the repo root) and fill in real values.
# .env is gitignored - never commit real secrets.

NODE_ENV=production
PORT=4000

# Base URL the app is reachable at - used to build links in emails (account
# setup links, "view this report" links). Set this to the real
# externally-reachable address in production.
APP_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# MariaDB
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=epreport
DB_USER=root
DB_PASS=password
DB_DIALECT=mariadb

# ---------------------------------------------------------------------------
# Email (password reset codes, new-account setup links, and daily report
# submission notifications all go through this configuration).
# Set SEND_EMAILS=false to disable outbound mail entirely - in that case
# every email is written to the application log instead (and still recorded
# in the email_log audit table with status "skipped"), so no mail server is
# required for local development.
# ---------------------------------------------------------------------------
SEND_EMAILS=true
EMAIL_HOST=10.78.4.11
EMAIL_PORT=25
EMAIL_SECURE=false
EMAIL_USER=noreply@portseattle.org
EMAIL_SENDER=noreply@portseattle.org
# Only needed if the mail relay requires authentication.
EMAIL_PASSWORD=
# Used by scripts/tests that want to send a sample email without touching
# real users' inboxes.
TEST_EMAIL_USER=shahid.u@portseattle.org

# ---------------------------------------------------------------------------
# JWT authentication
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=10h
JWT_ALGORITHM=HS256

# ---------------------------------------------------------------------------
# Password reset code policy
# ---------------------------------------------------------------------------
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# How long a new-account / admin-reset "set your password" email link stays
# valid for, in hours.
ACCOUNT_SETUP_TOKEN_TTL_HOURS=48

# ---------------------------------------------------------------------------
# Initial administrator account (used by `npm run seed:admin`)
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# CORS - only relevant if the client is served from a different origin than
# the API (e.g. running `npm run dev` with the Vite dev server). Leave unset
# in production, where the built client is served by this same app.
# ---------------------------------------------------------------------------
# CLIENT_ORIGIN=http://localhost:5173
