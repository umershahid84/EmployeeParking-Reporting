# Employee Parking Daily Reporting Application
# Copy this file to .env (at the repo root) and fill in real values.
# .env is gitignored - never commit real secrets.

NODE_ENV=production
PORT=4000

# Network interface to bind to. "0.0.0.0" (the default if unset) listens on
# every interface, so the app is reachable at the server's own LAN/public IP
# (e.g. http://10.78.4.13:4000), not just from the machine it runs on. Only
# set this to a specific interface address if you deliberately want to
# restrict which network the app is reachable from.
HOST=0.0.0.0

# Base URL the app is reachable at - used to build links in emails (account
# setup links, "view this report" links). MUST be set to the real
# externally-reachable address in production (e.g.
# http://10.78.4.13:4000 or a real hostname) - leaving this as localhost
# means every link emailed to users will point to "localhost" on whatever
# machine opens the email, not your server, and will not work for anyone.
# If you're deploying behind a reverse proxy under a sub-path (see
# BASE_PATH below), include that sub-path here too, e.g.
# https://vpn.example.com/epreport
APP_URL=http://localhost:4000

# Sub-path to serve the whole app under, for reverse-proxying it at a path
# rather than a dedicated domain/port (e.g. an Apache VPN portal proxying
# https://vpn.example.com/epreport straight through to this app). Leave
# unset (or "/") to serve from the domain root, which is the default and
# needs no Apache/proxy changes at all. See README.md's "Reverse proxy
# under a sub-path" section for the matching Apache config. Rebuild the
# client (`npm run build`) after changing this - it's baked into the
# built assets, not read at runtime.
# BASE_PATH=/epreport

# ---------------------------------------------------------------------------
# MariaDB
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=epreport
DB_USER=root
DB_PASS=password
DB_DIALECT=mariadb

# ---------------------------------------------------------------------------
# Email (password reset codes, new-account setup links, and daily report
# submission notifications all go through this configuration).
# Set SEND_EMAILS=false to disable outbound mail entirely - in that case
# every email is written to the application log instead (and still recorded
# in the email_log audit table with status "skipped"), so no mail server is
# required for local development.
# ---------------------------------------------------------------------------
SEND_EMAILS=true
EMAIL_HOST=10.78.4.11
EMAIL_PORT=25
EMAIL_SECURE=false
EMAIL_USER=noreply@portseattle.org
EMAIL_SENDER=noreply@portseattle.org
# Only needed if the mail relay requires authentication.
EMAIL_PASSWORD=
# Used by scripts/tests that want to send a sample email without touching
# real users' inboxes.
TEST_EMAIL_USER=shahid.u@portseattle.org

# Nodemailer tries STARTTLS opportunistically whenever the relay advertises
# it, even with EMAIL_SECURE=false - so a relay with an expired or
# self-signed certificate will fail with "certificate has expired" /
# ESOCKET unless you either skip TLS (common for a trusted internal relay
# on your own network) or stop validating the certificate:
#   EMAIL_IGNORE_TLS=true                 - don't attempt TLS at all (plaintext)
#   EMAIL_TLS_REJECT_UNAUTHORIZED=false   - use TLS but accept an invalid/expired cert
# Leave both at their defaults (false / true) for a properly certificated
# public mail server.
EMAIL_IGNORE_TLS=false
EMAIL_TLS_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------------
# JWT authentication
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=10h
JWT_ALGORITHM=HS256

# ---------------------------------------------------------------------------
# Password reset code policy
# ---------------------------------------------------------------------------
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# How long a new-account / admin-reset "set your password" email link stays
# valid for, in hours.
ACCOUNT_SETUP_TOKEN_TTL_HOURS=48

# ---------------------------------------------------------------------------
# Initial administrator account (used by `npm run seed:admin`)
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# CORS - only relevant if the client is served from a different origin than
# the API (e.g. running `npm run dev` with the Vite dev server). Leave unset
# in production, where the built client is served by this same app.
# ---------------------------------------------------------------------------
# CLIENT_ORIGIN=http://localhost:5173
